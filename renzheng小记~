package me.renzheng;

import org.junit.jupiter.api.Test;

import java.util.function.BiFunction;
import java.util.function.Consumer;
import java.util.function.Function;
import java.util.function.Predicate;
import java.util.function.Supplier;

/**
 * Java Function Interface Tests
 *
 * @author Renzheng Zhang
 */
public class FunctionTests {

    @Test
    public void testConsumer() {
        Consumer<String> consumer = new Consumer<String>() {
            @Override
            public void accept(String s) {
                System.out.println(s);
            }
        };
        consumer = System.out::println;
        consumer.accept("Hello World");
    }

    @Test
    public void testSupplier() {
        Supplier<String> supplier = new Supplier<String>() {
            @Override
            public String get() {
                return "Hello World";
            }
        };
        supplier = () -> "Hello World";
        System.out.println(supplier.get());
    }

    @Test
    public void testFunction() {
        Function<String, String> function = new Function<String, String>() {
            @Override
            public String apply(String s) {
                return s.toUpperCase();
            }
        };
        function = String::toUpperCase;
        System.out.println(function.apply("Hello World"));
    }

    @Test
    public void testBiFunction() {
        BiFunction<String, String, String> biFunction = new BiFunction<String, String, String>() {
            @Override
            public String apply(String s1, String s2) {
                return s1 + s2;
            }
        };
        biFunction = (s1, s2) -> s1 + s2;
        System.out.println(biFunction.apply("Hello ", "World"));
    }

    @Test
    @SuppressWarnings("ConstantConditions")
    public void testPredicate() {
        Predicate<String> predicate = new Predicate<String>() {
            @Override
            public boolean test(String s) {
                return s.equals("Hello World");
            }
        };
        predicate = s -> s.equals("Hello World");
        System.out.println(predicate.test("Hello World"));
    }
}
